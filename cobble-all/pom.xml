<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>net.hasor</groupId>
        <artifactId>cobble-parent</artifactId>
        <version>4.7.2-SNAPSHOT</version>
    </parent>

    <artifactId>cobble-all</artifactId>
    <packaging>jar</packaging>
    <name>Cobble All-in-One</name>

    <dependencies>
        <dependency>
            <groupId>net.hasor</groupId>
            <artifactId>cobble-lang</artifactId>
            <scope>compile</scope>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>net.hasor</groupId>
            <artifactId>cobble-dynamic</artifactId>
            <scope>compile</scope>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>net.hasor</groupId>
            <artifactId>cobble-settings</artifactId>
            <scope>compile</scope>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>net.hasor</groupId>
            <artifactId>cobble-loader</artifactId>
            <scope>compile</scope>
            <optional>true</optional>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- 把 asm 的源码和 class 集成到项目中 -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <version>3.6.0</version>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals>
                            <goal>shade</goal>
                        </goals>
                        <configuration>
                            <createSourcesJar>true</createSourcesJar>
                            <createDependencyReducedPom>false</createDependencyReducedPom>
                            <artifactSet>
                                <includes>
                                    <include>net.hasor:cobble-dynamic</include>
                                    <include>net.hasor:cobble-lang</include>
                                    <include>net.hasor:cobble-loader</include>
                                    <include>net.hasor:cobble-settings</include>
                                </includes>
                            </artifactSet>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
